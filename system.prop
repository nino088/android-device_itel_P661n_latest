# Fstab
ro.postinstall.fstab.prefix=/system

# USB MTP
ro.sys.usb.storage.type=mtp

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.support_metadata_encrypt=true

# TEE
ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_trustonic_tee_support=1

# Gatekeeper
ro.hardware.kmsetkey=trustonic
ro.hardware.gatekeeper=trustonic

# Keymaster
keymaster_ver=4.1

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Timezone
persist.sys.timezone="Africa/lagos"

# OTG
persist.sys.isUsbOtgEnabled=true
sys.usb.controller=a600000.dwc3
sys.usb.rndis.func.name=rndis_bam
sys.usb.rmnet.func.name=rmnet_bam

